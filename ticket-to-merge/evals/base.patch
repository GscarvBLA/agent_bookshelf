+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import request from 'supertest';
+import app from '../../src/server.js';
+import { initDb, closeDb } from '../../src/db/index.js';
+
+beforeEach(async () => {
+  await initDb('/tmp/test-books-html.db');
+});
+
+afterEach(() => {
+  closeDb();
+  const fs = require('fs');
+  try {
+    fs.unlinkSync('/tmp/test-books-html.db');
+  } catch (e) {
+    // ignore
+  }
+});
+
+const XSS = '<script>alert(1)</script>';
+
+describe('GET /books/search', () => {
+  it('AC8: returns a layout-free fragment with matching books only', async () => {
+    const res = await request(app).get('/books/search?q=tolk');
+    expect(res.status).toBe(200);
+    expect(res.text).toContain('class="book-grid"');
+    expect(res.text).toContain('The Hobbit');
+    expect(res.text).toContain('The Lord of the Rings');
+    expect(res.text).not.toContain('Dune');
+    expect(res.text).not.toContain('<html');
+    expect(res.text).not.toContain('<nav');
+    expect((res.text.match(/class="book-card"/g) ?? []).length).toBe(2);
+  });
+
+  it('AC8: matches ignoring case, including non-ASCII', async () => {
+    const res = await request(app).get('/books/search?q=' + encodeURIComponent('MIÉVILLE'));
+    expect(res.status).toBe(200);
+    expect(res.text).toContain('The City &amp; the City');
+    expect(res.text).not.toContain('The Hobbit');
+  });
+
+  it('AC9: no matches returns No books found and no grid', async () => {
+    const res = await request(app).get('/books/search?q=zzzzqqqq');
+    expect(res.status).toBe(200);
+    expect(res.text).toContain('No books found');
+    expect(res.text).toContain('class="search-message"');
+    expect(res.text).not.toContain('book-grid');
+    expect(res.text).not.toContain('<html');
+  });
+
+  it('AC15: SQL injection and literal wildcards match nothing', async () => {
+    for (const q of ["' OR 1=1 --", '%', '_']) {
+      const res = await request(app).get('/books/search?q=' + encodeURIComponent(q));
+      expect(res.status).toBe(200);
+      expect(res.text).toContain('No books found');
+    }
+  });
+
+  it('AC15: digits are an ordinary search', async () => {
+    const res = await request(app).get('/books/search?q=1984');
+    expect(res.status).toBe(200);
+    expect((res.text.match(/class="book-card"/g) ?? []).length).toBe(1);
+  });
+
+  it('AC15: empty and missing q return all books', async () => {
+    for (const qs of ['', '?q=', '?q=%20%20']) {
+      const res = await request(app).get('/books/search' + qs);
+      expect(res.status).toBe(200);
+      expect((res.text.match(/class="book-card"/g) ?? []).length).toBe(50);
+    }
+  });
+
+  it('AC10: too long query returns 400 error fragment', async () => {
+    for (const len of [101, 10000]) {
+      const res = await request(app).get('/books/search?q=' + 'a'.repeat(len));
+      expect(res.status).toBe(400);
+      expect(res.text).toContain('<p class="error">Search query must be 100 characters or fewer</p>');
+      expect(res.text).not.toContain('<html');
+    }
+  });
+
+  it('AC10: repeated and object parameters return 400 error fragment', async () => {
+    for (const qs of ['?q=a&q=b', '?q[x]=1']) {
+      const res = await request(app).get('/books/search' + qs);
+      expect(res.status).toBe(400);
+      expect(res.text).toContain('<p class="error">Search query must be a single value</p>');
+      expect(res.text).not.toContain('<html');
+    }
+  });
+
+  it('AC10/AC15: control characters return 400 error fragment', async () => {
+    for (const qs of ['?q=%00', '?q=a%09b']) {
+      const res = await request(app).get('/books/search' + qs);
+      expect(res.status).toBe(400);
+      expect(res.text).toContain('<p class="error">Search query contains invalid characters</p>');
+      expect(res.text).not.toContain('<html');
+    }
+  });
+
+  it('AC11: script query is escaped in the no-results message', async () => {
+    const res = await request(app).get('/books/search?q=' + encodeURIComponent(XSS));
+    expect(res.status).toBe(200);
+    expect(res.text).not.toContain(XSS);
+    expect(res.text).not.toContain('<script>');
+  });
+
+  it('AC11: script query is escaped in the error fragment', async () => {
+    const res = await request(app).get(
+      '/books/search?q=' + encodeURIComponent(XSS + '\u0001' + 'a'.repeat(100))
+    );
+    expect(res.status).toBe(400);
+    expect(res.text).not.toContain(XSS);
+    expect(res.text).not.toContain('<script>');
+  });
+});
